# FlowForge configuration (copy to .env; .env is gitignored).
# The MVP is a local developer tool and needs almost no configuration.

# Where the local run/event store lives (SQLite). Default: ~/.flowforge/runs.db
FLOWFORGE_DB=

# The workbench server binds loopback by default. Only change these if you
# understand that the local-run endpoint executes your pipeline code.
# FLOWFORGE_HOST=127.0.0.1
# FLOWFORGE_PORT=8080
